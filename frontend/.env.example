# Set to "true" to bypass MSAL auth in local dev.
# Must mirror the backend's techdebt.security.dev-bypass setting.
VITE_DEV_BYPASS=true

# Azure AD config — only consulted when VITE_DEV_BYPASS=false
VITE_AZURE_AD_CLIENT_ID=
VITE_AZURE_AD_TENANT_ID=
VITE_AZURE_AD_REDIRECT_URI=http://localhost:9211/auth/callback
VITE_AZURE_AD_API_SCOPE=
